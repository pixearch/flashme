generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// --- ENUMS ---
enum Visibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

enum AccessRole {
  VIEWER // View Only
  CLONER // View and Download
  EDITOR // View, Download, and Edit
}

// --- MODELS ---

model User {
  id        String   @id
  email     String   @unique
  studySessions StudySession[]
  // Add other user fields here if needed later
}

model Deck {
  id            String      @id @default(cuid())
  userId        String
  title         String
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Sharing Fields
  visibility    Visibility  @default(PRIVATE)
  sharePassword String?
  allowClone    Boolean     @default(true)

  // Relations
  cards         Card[]
  tags          Tag[]
  accessList    DeckAccess[]
  studySessions StudySession[]

  @@index([userId])
  @@index([visibility])
}

model Card {
  id          String   @id @default(cuid())
  front       String
  back        String
  status      String   @default("new")
  orderIndex  Int      @default(0)
  
  deckId      String
  deck        Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  
  tags        Tag[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deckId])
  @@index([deckId, orderIndex])
}

model Tag {
  id      String @id @default(cuid())
  name    String
  color   String
  userId  String
  
  decks   Deck[]
  cards   Card[]

  @@index([userId])
}

model DeckAccess {
  id        String     @id @default(cuid())
  deckId    String
  deck      Deck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  userEmail String
  role      AccessRole @default(VIEWER)
  
  createdAt DateTime   @default(now())

  @@unique([deckId, userEmail])
  @@index([userEmail])
  @@index([deckId])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  deckId    String
  cardIndex Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([userId, deckId])
  @@index([userId])
  @@index([deckId])
}
